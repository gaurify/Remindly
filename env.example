# Copy this file's values into the right place — never commit real secrets.
#
# PUBLIC values (safe in client-side code) go in js/config.js:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   VAPID_PUBLIC_KEY
#
# SECRET values (server-only) are set with the Supabase CLI, e.g.:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# They should NEVER appear in any file committed to this repo.

# --- Edge Function secrets (supabase/functions/send-reminders) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
